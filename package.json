{
  "name": "zenkai-desktop",
  "version": "1.0.3",
  "description": "Zenkai desktop shell — wraps the Zenkai web app in a secure Electron window",
  "homepage": "https://github.com/johan-droid/Zenkai-Desktop-#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/johan-droid/Zenkai-Desktop-.git"
  },
  "author": {
    "name": "Nyyrox",
    "email": "dev@zenkai.cfd"
  },
  "private": true,
  "main": "out/main/index.js",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb -p never",
    "dist:win": "pnpm build && electron-builder --win -p never",
    "dist:mac": "pnpm build && electron-builder --mac -p never",
    "release:check": "node scripts/verify-zero-mock.mjs",
    "release:verify": "node scripts/verify-artifacts.mjs",
    "release:version": "node scripts/release-version.mjs",
    "qa:doctor": "node scripts/qa-doctor.mjs",
    "qa:registry": "node scripts/validate-qa-registry.mjs",
    "qa:unit": "vitest run tests/unit",
    "qa:integration": "vitest run tests/unit/stream-proxy.test.ts tests/unit/updater.test.ts tests/unit/hls.test.ts",
    "qa:browser": "env -u ELECTRON_RUN_AS_NODE xvfb-run -a playwright test tests/e2e/home-layout.spec.ts tests/e2e/shell.spec.ts",
    "qa:electron": "env -u ELECTRON_RUN_AS_NODE xvfb-run -a playwright test tests/e2e/app.spec.ts tests/e2e/qa-workflows.spec.ts",
    "qa:desktop": "vitest run tests/unit/desktop-navigation.test.ts tests/unit/notify.test.ts",
    "qa:gpu": "vitest run tests/unit/gpu.test.ts tests/unit/vision-hardware.test.ts tests/unit/vision-live.test.ts",
    "qa:accessibility": "node scripts/validate-qa-registry.mjs",
    "qa:visual": "ls -l qa/screenshots/*.png",
    "qa:security": "vitest run tests/unit/shield.test.ts tests/unit/ssrf-maturity.test.ts tests/unit/ipc-validation.test.ts",
    "qa:performance": "vitest run tests/unit/canary-health.test.ts",
    "qa:regression": "pnpm typecheck && pnpm lint && pnpm qa:unit && pnpm qa:electron",
    "qa:report": "node scripts/generate-qa-report.mjs",
    "qa:all": "node scripts/qa-runner.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@webgpu/types": "^0.1.74",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@xhayper/discord-rpc": "^1.5.1",
    "anime4k-webgpu": "^1.0.0",
    "electron-updater": "6.8.11",
    "falling-snow": "^1.0.0",
    "framer-motion": "^14.14.0",
    "gifenc": "^1.0.3",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.73.0",
    "onnxruntime-node": "^1.31.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "desktopName": "zenkai.desktop"
}
