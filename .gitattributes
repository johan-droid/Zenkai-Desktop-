# Enforce LF line endings for all text files across platforms
* text=auto eol=lf

# Explicit Text Formats
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.plist text eol=lf

# Binary Formats (do not touch or convert line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.woff2 binary
*.zip binary
*.mp4 binary
*.ts-video binary
*.AppImage binary
*.exe binary
*.deb binary
*.rpm binary
*.blockmap binary

